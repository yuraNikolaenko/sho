<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Str.AppTitle">Shozilla</sys:String>
    <sys:String x:Key="Str.Folder">Folder:</sys:String>
    <sys:String x:Key="Str.Folders">Folders:</sys:String>
    <sys:String x:Key="Str.Browse">Browse…</sys:String>
    <sys:String x:Key="Str.ChooseFolders">Choose folders…</sys:String>
    <sys:String x:Key="Str.PickFoldersTitle">Select folders to search / index</sys:String>
    <sys:String x:Key="Str.PickFoldersSummary">Tick folders in the file-system tree</sys:String>
    <sys:String x:Key="Str.Ok">OK</sys:String>
    <sys:String x:Key="Str.ClearAll">Clear all</sys:String>
    <sys:String x:Key="Str.Find">Find:</sys:String>
    <sys:String x:Key="Str.Search">Search</sys:String>
    <sys:String x:Key="Str.UseIndex">Use index</sys:String>
    <sys:String x:Key="Str.MatchCase">Match case</sys:String>
    <sys:String x:Key="Str.WholeWord">Whole word</sys:String>
    <sys:String x:Key="Str.IndexBuilt">  Index: built</sys:String>
    <sys:String x:Key="Str.IndexNotBuilt">  Index: not built</sys:String>
    <sys:String x:Key="Str.BuildIndex">Build index</sys:String>
    <sys:String x:Key="Str.UpdateIndex">Update index</sys:String>
    <sys:String x:Key="Str.UpdateIndexTooltip">Pick up added files, drop deleted ones, re-index changed ones — without a full rebuild</sys:String>
    <sys:String x:Key="Str.DeleteIndex">Delete index</sys:String>
    <sys:String x:Key="Str.Cancel">Cancel</sys:String>
    <sys:String x:Key="Str.FilesGroup">Files (matches)</sys:String>
    <sys:String x:Key="Str.LinesGroup">Lines (context)</sys:String>
    <sys:String x:Key="Str.OnlySelectedFile">Only from selected file</sys:String>
    <sys:String x:Key="Str.AiMode">AI mode</sys:String>
    <sys:String x:Key="Str.AiAnalysisTooltip">Local AI mode (order classification, event extraction, person timeline) — will be enabled in a future update</sys:String>
    <sys:String x:Key="Str.AiAnalysisStub">AI mode not implemented yet. Will be wired up in a future session — Qwen2.5-1.5B locally, no cloud.</sys:String>
    <sys:String x:Key="Str.CompactMode">Compact mode</sys:String>
    <sys:String x:Key="Str.CompactModeTooltip">Hide everything except the search box — more room for results and preview</sys:String>
    <sys:String x:Key="Str.OnlySelectedFileTooltip">Narrows the Lines panel to the selected file; uncheck to see every matched line</sys:String>
    <sys:String x:Key="Str.Col.Path">Path</sys:String>
    <sys:String x:Key="Str.Col.File">File</sys:String>
    <sys:String x:Key="Str.ClearFilter">Clear filter</sys:String>
    <sys:String x:Key="Str.AutoUpdateIndex">Auto-update index</sys:String>
    <sys:String x:Key="Str.AutoUpdateIndexTooltip">Watch selected folders and update the index incrementally as files change (FileSystemWatcher)</sys:String>
    <sys:String x:Key="Str.FilterPath">Path filter:</sys:String>
    <sys:String x:Key="Str.FilterPathPlaceholder">substring(s) in the full path, space-separated (all must match)</sys:String>
    <sys:String x:Key="Str.FilterPathTooltip">Narrows files and lines to those whose full path contains ALL entered substrings (case-insensitive)</sys:String>
    <sys:String x:Key="Str.LangCode">EN</sys:String>
    <sys:String x:Key="Str.Preview">Preview</sys:String>
