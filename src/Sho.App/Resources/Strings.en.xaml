    <sys:String x:Key="Str.Reveal">Reveal in Explorer</sys:String>
    <sys:String x:Key="Str.CopyPath">Copy path</sys:String>
    <sys:String x:Key="Str.Theme">Theme</sys:String>
    <sys:String x:Key="Str.Language">Language</sys:String>
    <sys:String x:Key="Str.Ready">Ready</sys:String>
    <sys:String x:Key="Str.Cancelled">Cancelled</sys:String>

