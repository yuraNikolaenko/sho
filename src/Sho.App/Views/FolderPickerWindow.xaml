<ui:FluentWindow x:Class="Sho.App.Views.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Sho.App.Views"
        Title="{DynamicResource Str.PickFoldersTitle}"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource Str.PickFoldersTitle}"
                     ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="FolderOpen24" Foreground="#FF5722"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Margin="16,8,16,8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <TreeView x:Name="Tree"
                      ItemsSource="{Binding Roots, RelativeSource={RelativeSource AncestorType=local:FolderPickerWindow}}"
                      Background="Transparent" BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <ui:SymbolIcon Symbol="Folder24" Margin="6,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <DockPanel Grid.Row="2" Margin="16,0,16,16">
            <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.Cancel}"
                       Margin="6,0,0,0" Padding="14,5"
                       Click="CancelButton_Click"/>
            <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.Ok}"
                       Margin="6,0,0,0" Padding="14,5"
                       Appearance="Primary"
                       Click="OkButton_Click" IsDefault="True"/>
            <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.ClearAll}"
                       Margin="6,0,0,0" Padding="10,5"
                       Click="ClearAllButton_Click"/>
            <TextBlock x:Name="SummaryLabel"
                       VerticalAlignment="Center" Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Text="{DynamicResource Str.PickFoldersSummary}"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
