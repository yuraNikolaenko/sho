<Application x:Class="Sho.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Sho.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Hard contrast brushes for results tables — mutated from code on theme switch -->
            <SolidColorBrush x:Key="ResultsBackground" Color="#000000"/>
            <SolidColorBrush x:Key="ResultsForeground" Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
