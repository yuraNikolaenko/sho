<ui:FluentWindow x:Class="Sho.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Sho.App.ViewModels"
        xmlns:conv="clr-namespace:Sho.App.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource Str.AppTitle}"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        FontFamily="Segoe UI Variable" FontSize="13">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <conv:BoolToIndexStatusConverter x:Key="BoolToIndexStatusConverter"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <conv:StringsEqualConverter x:Key="StringsEqualConverter"/>

        <Style x:Key="ResultsDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ResultsBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ResultsForeground}"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinesDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ResultsDataGrid}">
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource StringsEqualConverter}">
                                        <Binding Path="FilePath"/>
                                        <Binding Path="DataContext.SelectedFile.FilePath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource Str.AppTitle}"
                     ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="SearchInfo24" Foreground="#FF5722"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:Card Grid.Row="1" Margin="16,0,16,4" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.Search}"
                                   Margin="6,0,0,0" Padding="18,3"
                                   Appearance="Primary"
                                   Command="{Binding SearchCommand}" IsDefault="True"
                                   Icon="{ui:SymbolIcon Search24}"/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{DynamicResource Str.Find}" Width="56"/>
                        <ComboBox x:Name="QueryComboBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding QueryHistory}"
                                  KeyDown="QueryComboBox_KeyDown"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Grid.Row="2">
                        <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Str.ChooseFolders}"
                                   Margin="6,0,0,0" Padding="12,3"
                                   Click="ChooseFoldersButton_Click"
                                   Icon="{ui:SymbolIcon FolderOpen24}"/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{DynamicResource Str.Folders}" Width="56"/>
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FolderSummary}"
                                       Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Grid>

                <Border Grid.Column="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0" Margin="2,0"/>

                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                    <CheckBox Content="{DynamicResource Str.UseIndex}"
                              IsChecked="{Binding UseIndex}" Margin="0,2"/>
                    <CheckBox Content="{DynamicResource Str.MatchCase}"
                              IsChecked="{Binding CaseSensitive}" Margin="0,2"/>
                    <CheckBox Content="{DynamicResource Str.WholeWord}"
                              IsChecked="{Binding WholeWord}" Margin="0,2"/>
                </StackPanel>

                <Border Grid.Column="3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0" Margin="2,0"/>

                <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Width" Value="190"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </StackPanel.Resources>
                    <ui:Button Content="{DynamicResource Str.BuildIndex}"
                               Command="{Binding BuildIndexCommand}"
                               Icon="{ui:SymbolIcon DatabaseSearch24}"/>
                    <ui:Button Content="{DynamicResource Str.DeleteIndex}"
                               Command="{Binding DeleteIndexCommand}"
                               Icon="{ui:SymbolIcon Delete24}"/>
                    <ui:Button Content="{DynamicResource Str.Cancel}"
                               Command="{Binding CancelCommand}"
                               Icon="{ui:SymbolIcon Stop24}"/>
                </StackPanel>

                <Border Grid.Column="5" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0" Margin="2,0"/>

                <StackPanel Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="MinWidth" Value="110"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="8,2"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </StackPanel.Resources>
                    <ui:Button x:Name="ThemeButton"
                               Icon="{ui:SymbolIcon WeatherMoon24}"
                               Click="ThemeButton_Click"
                               ToolTip="{DynamicResource Str.Theme}"
                               Content="{DynamicResource Str.Theme}"/>
                    <ui:Button x:Name="LanguageButton"
                               Click="LanguageButton_Click"
                               ToolTip="{DynamicResource Str.Language}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Globe24"/>
                            <TextBlock x:Name="LanguageLabel" Text="UA" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="PreviewButton"
                               Click="PreviewButton_Click"
                               ToolTip="{DynamicResource Str.PreviewToggleTooltip}"
                               Content="{DynamicResource Str.Preview}"
                               Icon="{ui:SymbolIcon Eye24}"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2" Margin="16,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Margin="14,10,14,6" FontWeight="SemiBold"
                               Text="{DynamicResource Str.FilesGroup}"/>
                    <DataGrid Style="{StaticResource ResultsDataGrid}"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              MouseDoubleClick="FilesGrid_MouseDoubleClick"
                              Name="FilesGrid">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Str.Open}" Click="MenuOpen_Click"/>
                                <MenuItem Header="{DynamicResource Str.Reveal}" Click="MenuReveal_Click"/>
                                <MenuItem Header="{DynamicResource Str.CopyPath}" Click="MenuCopyPath_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="32" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding FilePath, Converter={StaticResource PathToIconConverter}}"
                                               Width="16" Height="16" Margin="6,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               UseLayoutRounding="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Str.Col.File}" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Col.Hits}" Binding="{Binding HitCount}" Width="60"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Col.Modified}"
                                                Binding="{Binding ModifiedUtc, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                                                Width="120" SortDirection="Ascending"/>
                            <DataGridTextColumn Header="{DynamicResource Str.Col.Path}" Binding="{Binding FilePath}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2" x:Name="RightColumnGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition x:Name="PreviewSplitterRow" Height="0"/>
                    <RowDefinition x:Name="PreviewRow" Height="0"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Margin="14,10,14,6" FontWeight="SemiBold"
                                   Text="{DynamicResource Str.LinesGroup}"/>
                        <DataGrid Style="{StaticResource LinesDataGrid}"
                                  ItemsSource="{Binding Lines}"
                                  SelectedItem="{Binding SelectedHit, Mode=TwoWay}"
                                  RowHeight="22"
                                  MouseDoubleClick="LinesGrid_MouseDoubleClick"
                                  Name="LinesGrid">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str.Open}" Click="MenuLineOpen_Click"/>
                                    <MenuItem Header="{DynamicResource Str.Reveal}" Click="MenuLineReveal_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Str.Col.File}" Binding="{Binding FilePath, Converter={StaticResource PathToFileNameConverter}}" Width="180"/>
                                <DataGridTextColumn Header="{DynamicResource Str.Col.Line}" Binding="{Binding LineNumber}" Width="60"/>
                                <DataGridTextColumn Header="{DynamicResource Str.Col.Snippet}" Binding="{Binding Snippet}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold"
                                       Text="{DynamicResource Str.PreviewGroup}"/>
                            <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" Opacity="0.6" FontSize="11"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedHit.FilePath, Converter={StaticResource PathToFileNameConverter}, FallbackValue=''}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid>
                            <wv2:WebView2 Name="PreviewWebView"/>
                            <TextBlock x:Name="PreviewError" Visibility="Collapsed"
                                       Margin="20" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       FontFamily="Segoe UI" FontSize="13"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="16,2,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Height="3" Margin="0,0,0,3"
                         Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="11" Opacity="0.85"/>
                <Border Grid.Column="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0" Margin="10,2,10,2"/>
                <TextBlock Grid.Column="2" Text="{Binding IndexInfoText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="11" Opacity="0.85"
                           Foreground="{Binding IndexExists, Converter={StaticResource BoolToBrushConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
